# Names only — set real values in Vercel → Settings → Environment Variables.
# See docs/SETUP-ENV.md for the full guide. Never commit real secrets.

# Owner cockpit secure login (api/auth/*)
SESSION_SECRET=
OWNER_PASSWORD_HASH=

# Cockpit live feeds (optional; graceful sample fallback without them)
GITHUB_TOKEN=
VERCEL_TOKEN=

# BMLA Mastery beta signups (optional; signup still returns ok without it)
RESEND_API_KEY=
BMLA_NOTIFY_EMAIL=
